{
  "name": "@flaminc/books-backend",
  "description": "Backend for the books app",
  "version": "0.0.0-development",
  "author": "capitN.flam",
  "scripts": {
    "build": "nest build",
    "clean": "rimraf --glob dist coverage flaminc-books-backend-*.tgz",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:ci:coverage": "vitest --run --coverage",
    "type-check": "tsc --pretty --noEmit",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d ./src/typeorm/cli.config.ts",
    "typeorm:seed": "ts-node ./node_modules/typeorm/cli.js -d ./src/typeorm/seed.ts"
  },
  "bugs": "https://github.com/capitnflam/books-backend/issues",
  "dependencies": {
    "@flaminc/books-types": "1.2.1",
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/typeorm": "10.0.2",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "helmet": "7.1.0",
    "nestjs-typeorm-paginate": "4.0.4",
    "nestjs-zod": "3.0.0",
    "pg": "8.13.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.20",
    "yargs": "17.7.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@commitlint/types": "19.5.0",
    "@faker-js/faker": "9.0.3",
    "@flaminc/eslint-plugin": "1.6.0",
    "@flaminc/semantic-release-configs": "1.0.2",
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@swc/core": "1.7.28",
    "@types/express": "5.0.0",
    "@types/node": "22.7.4",
    "@types/yargs": "17.0.33",
    "@vitest/coverage-v8": "2.1.1",
    "@vitest/ui": "2.1.1",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "semantic-release": "24.1.1",
    "syncpack": "13.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.1"
  },
  "files": [
    "package.json",
    "dist"
  ],
  "homepage": "https://github.com/capitnflam/books-backend#readme",
  "license": "MIT",
  "main": "dist/main.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": "capitnflam/books-backend"
}
