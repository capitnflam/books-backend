{
  "name": "@flaminc/books-backend",
  "description": "Backend for the books app",
  "version": "0.0.0-development",
  "author": "capitN.flam",
  "scripts": {
    "build": "nest build",
    "clean": "rimraf --glob dist coverage flaminc-books-backend-*.tgz",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:ci:coverage": "vitest --run --coverage",
    "type-check": "tsc --pretty --noEmit",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d ./src/typeorm/cli.config.ts",
    "typeorm:seed": "ts-node ./node_modules/typeorm/cli.js -d ./src/typeorm/seed.ts"
  },
  "bugs": "https://github.com/capitnflam/books-backend/issues",
  "dependencies": {
    "@flaminc/books-types": "1.2.2",
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/typeorm": "11.0.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "nestjs-paginate": "11.1.0",
    "nestjs-zod": "4.3.1",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.21",
    "yargs": "17.7.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@commitlint/types": "19.8.0",
    "@faker-js/faker": "9.6.0",
    "@flaminc/eslint-plugin": "1.7.0",
    "@flaminc/semantic-release-configs": "1.0.3",
    "@nestjs/cli": "11.0.5",
    "@nestjs/testing": "11.0.11",
    "@swc/core": "1.11.8",
    "@types/express": "5.0.0",
    "@types/node": "22.13.9",
    "@types/yargs": "17.0.33",
    "@vitest/coverage-v8": "3.1.2",
    "@vitest/ui": "3.0.8",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "semantic-release": "24.2.3",
    "sqlite3": "5.1.7",
    "syncpack": "13.0.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "unplugin-swc": "1.5.1",
    "vitest": "3.0.8"
  },
  "files": [
    "package.json",
    "dist"
  ],
  "homepage": "https://github.com/capitnflam/books-backend#readme",
  "license": "MIT",
  "main": "dist/main.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": "capitnflam/books-backend"
}
